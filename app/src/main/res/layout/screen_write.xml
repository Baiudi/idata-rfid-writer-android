<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etSingleAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:textSize="14sp"
            android:inputType="text"
            android:hint="@string/hint_single_asset" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:textSize="14sp"
            android:inputType="text"
            android:hint="@string/hint_location" />

        <EditText
            android:id="@+id/etDept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:textSize="14sp"
            android:inputType="text"
            android:hint="@string/hint_dept" />

        <EditText
            android:id="@+id/etOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:textSize="14sp"
            android:inputType="text"
            android:hint="@string/hint_owner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <Button
                android:id="@+id/btnImportData"
                style="@style/Widget.RfidWriter.OutlineButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_import_data" />
            <Button
                android:id="@+id/btnTemplate"
                style="@style/Widget.RfidWriter.OutlineButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_template" />
        </LinearLayout>

        <Button
            android:id="@+id/btnWriteSingle"
            style="@style/Widget.RfidWriter.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_write_single" />

        <Button
            android:id="@+id/btnStartWrite"
            style="@style/Widget.RfidWriter.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_start_write" />

        <Button
            android:id="@+id/btnAdd"
            style="@style/Widget.RfidWriter.OutlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_add" />

        <!-- A1 标签资产编号写入：仅写 USER 区，保留 App 4 方位标定用的 EPC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:paddingTop="10dp"
            android:background="#F2F6FF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/a1_section_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />

            <Button
                android:id="@+id/btnReadA1"
                style="@style/Widget.RfidWriter.OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_read_a1" />

            <Button
                android:id="@+id/btnWriteA1"
                style="@style/Widget.RfidWriter.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/btn_write_a1" />

            <TextView
                android:id="@+id/tvA1Result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tv_a1_result"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSingleResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tv_single_result"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/write_hint"
            android:textSize="13sp"
            android:textColor="#666666" />
    </LinearLayout>
</ScrollView>
