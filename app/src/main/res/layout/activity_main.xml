<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 上半部分：可滚动区域（参数/单张写入/批量写标/状态进度） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <!-- 设备/参数设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="连接UHF" />
        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="断开" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="4"
        android:layout_marginTop="8dp">

        <TextView android:text="@string/hint_power" />
        <EditText
            android:id="@+id/etPower"
            android:inputType="number"
            android:text="15" />

        <TextView android:text="@string/hint_module" />
        <EditText
            android:id="@+id/etModule"
            android:inputType="number"
            android:text="0" />

        <TextView android:text="@string/hint_target_bank" />
        <EditText
            android:id="@+id/etBank"
            android:inputType="number"
            android:text="3" />

        <TextView android:text="@string/hint_start_word" />
        <EditText
            android:id="@+id/etStartWord"
            android:inputType="number"
            android:text="0" />
    </GridLayout>

    <!-- 模拟模式开关：无硬件/无 SDK 时勾选，用于流程验证；接入真实 iData SDK 后取消勾选 -->
    <CheckBox
        android:id="@+id/chkSimulate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:text="模拟模式（无硬件/无SDK时勾选，用于流程验证）" />

    <!-- 单张标签写入 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textStyle="bold"
        android:text="@string/single_section" />

    <EditText
        android:id="@+id/etSingleAsset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="@string/hint_single_asset" />

    <EditText
        android:id="@+id/etLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="@string/hint_location" />

    <EditText
        android:id="@+id/etDept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="@string/hint_dept" />

    <EditText
        android:id="@+id/etOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="@string/hint_owner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnDetectSingle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_detect_single" />
        <Button
            android:id="@+id/btnWriteSingle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_write_single" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDetected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_detected"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvSingleResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_single_result"
        android:textSize="13sp" />

    <!-- 台账导入与批量写标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/btnImport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导入台账CSV" />
        <Button
            android:id="@+id/btnStartWrite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始批量写标" />
    </LinearLayout>

    <!-- 进度与状态 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="状态：未连接"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="进度：0 / 0"
        android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- 结果列表（固定高度，不参与滚动区域，内部自己滚动） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResults"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="true" />

    <!-- 同步到 dws 台账 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导出结果JSON" />
        <Button
            android:id="@+id/btnSync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="同步到dws台账" />
    </LinearLayout>
</LinearLayout>
