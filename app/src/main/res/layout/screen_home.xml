<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnSettings"
            style="@style/Widget.RfidWriter.OutlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_settings" />

        <Button
            android:id="@+id/btnRw"
            style="@style/Widget.RfidWriter.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/title_rw" />

        <Button
            android:id="@+id/btnInventoryHome"
            style="@style/Widget.RfidWriter.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/title_inventory" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_data"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <Button
                android:id="@+id/btnExport"
                style="@style/Widget.RfidWriter.OutlineButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_export" />
            <Button
                android:id="@+id/btnSync"
                style="@style/Widget.RfidWriter.OutlineButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_sync" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_hint"
            android:textSize="13sp"
            android:textColor="#666666" />
    </LinearLayout>
</ScrollView>
